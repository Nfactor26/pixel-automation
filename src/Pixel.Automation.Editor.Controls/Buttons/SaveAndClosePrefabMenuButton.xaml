<UserControl x:Class="Pixel.Automation.Editor.Controls.Buttons.SaveAndClosePrefabMenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pixel.Automation.Editor.Controls.Buttons"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Button Width="20" Height="20" Margin="0" Style="{DynamicResource MahApps.Styles.Button.Circle}" Content="{iconPacks:FontAwesome SaveRegular}" BorderThickness="0"
             Foreground="{DynamicResource MahApps.Brushes.Accent}" ToolTip="Close" Click="ShowContextMenu">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Save" Click="SaveChanges"></MenuItem>
                    <MenuItem Header="Close" Click="ClosePrefab"></MenuItem>                
                    <MenuItem Header="Save and Close" Click="SaveAndClosePrefab"></MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
</UserControl>
